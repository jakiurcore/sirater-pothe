{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seerah-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  // Routes/custom domains are NOT hardcoded: scripts/render-wrangler.mjs (phase 5) injects
  // mcp.$DOMAIN from the environment. For local dev the worker runs on localhost.
  "vars": {
    "MCP_ORIGIN": "http://localhost:8787",
    "WEB_ORIGIN": "http://localhost:3000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "seerah",
      "database_id": "f4474a63-eab5-42f3-be84-242badc27e20",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "f87de7da2ddf46aa95ad7cc9a069974a" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "seerah-media" }],
  // Responsive webp copies of uploaded pictures (480/960/1600 px). Optional at runtime: without it only the original is stored.
  "images": { "binding": "IMAGES" }
  // No secrets: users and password hashes live in D1 (`users`), created with `pnpm user:create`.
}
