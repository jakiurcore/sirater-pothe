{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seerah-backup",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Nightly at 02:00 UTC. No custom domain, no HTTP surface: the Worker only has a scheduled() handler.
  "triggers": { "crons": ["0 2 * * *"] },
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "RETENTION_DAYS": "30" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "seerah",
      "database_id": "f4474a63-eab5-42f3-be84-242badc27e20"
    }
  ],
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "seerah-backups" }]
}
