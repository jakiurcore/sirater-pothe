{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seerah-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "seerah-web" }],
  // Routes/custom domains are NOT hardcoded: scripts/render-wrangler.mjs (phase 5) injects $DOMAIN from the environment.
  "vars": {
    "WEB_ORIGIN": "http://localhost:3000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "seerah",
      "database_id": "f4474a63-eab5-42f3-be84-242badc27e20",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  // Map tiles (Protomaps PMTiles for the Arabian Peninsula), served by /tiles/arabia.pmtiles with Range support.
  // MEDIA: pictures uploaded through the MCP server (map / landscape / architecture / object / pattern / calligraphy only).
  // Read-only here; /media/[id] serves a picture only for a published event, or with a valid preview token for a draft.
  "r2_buckets": [
    { "binding": "TILES", "bucket_name": "seerah-tiles" },
    { "binding": "MEDIA", "bucket_name": "seerah-media" }
  ]
}
