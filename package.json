{
  "name": "seerah-timeline",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "build:quran": "pnpm --filter @seerah/content build:quran",
    "db:generate": "pnpm --filter @seerah/db generate",
    "user:create": "tsx scripts/user.ts create",
    "user:reset-password": "tsx scripts/user.ts reset-password",
    "user:enable-2fa": "tsx scripts/user.ts enable-2fa",
    "user:disable-2fa": "tsx scripts/user.ts disable-2fa",
    "user:disable": "tsx scripts/user.ts disable",
    "smoke:live": "tsx scripts/smoke-live.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "tsx": "^4.23.15",
    "qrcode": "^1.5.4",
    "@types/qrcode": "^1.5.5",
    "@types/node": "^22.0.0",
    "@seerah/auth": "workspace:*"
  }
}
